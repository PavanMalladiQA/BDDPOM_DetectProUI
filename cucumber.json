{
    "default": {
        "formatOptions": {
            "snippetInterface": "async-await"
        },
        "paths": [
            "tests/smoketest/features/*.feature"
        ],

        "publishQuiet": true,
        "dryRun": false,
        "require": [
            "tests/smoketest/steps/*.ts",
            "tests/smoketest/hooks/pagehooks.ts"
        ],

        "requireModule": [
            "ts-node/register"
        ],

        "format": [
            "html:reports/cucumber-report.html"
        ]
    }
}